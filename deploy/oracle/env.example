# Variables d'environnement pour le déploiement Oracle Cloud (voir deploy/oracle/README.md).
# Toutes sont OPTIONNELLES : les secrets absents sont générés automatiquement.
# Exemples d'export avant de lancer : export ORBITE_LLM_API_KEY='...'

# ---- Obligatoire ----
# Clé API Groq (l'IA réelle ne fonctionne pas sans elle).
ORBITE_LLM_API_KEY=

# ---- Réseau / domaine ----
# Si vide : le site tourne en HTTP sur l'IP publique (démo).
# Si renseigné (ex. orbite.duckdns.org) : HTTPS automatique via Let's Encrypt.
ORBITE_DOMAIN=
# Email requis par Let's Encrypt (si ORBITE_DOMAIN est renseigné).
ORBITE_EMAIL=
# IP publique à utiliser si autodétection impossible (facultatif).
ORBITE_PUBLIC_IP=

# ---- Secrets (générés si absents) ----
ORBITE_SECRET_KEY=
ORBITE_JWT_SIGNING_KEY=
ORBITE_DB_PASSWORD=

# ---- Optionnels ----
# Paiements Stripe. Sans eux, paiement en mode "manuel".
ORBITE_STRIPE_SECRET_KEY=
ORBITE_STRIPE_PUBLISHABLE_KEY=
ORBITE_STRIPE_WEBHOOK_SECRET=
# Recherche web enrichie (accès Wikipédia plein-texte garanti même sans cette clé).
ORBITE_TAVILY_API_KEY=

# ---- Avancé (défauts raisonnables, rarement modifiés) ----
ORBITE_LLM_PROVIDER=openai
ORBITE_LLM_MODEL=openai/gpt-oss-120b
ORBITE_WEB_SEARCH=1
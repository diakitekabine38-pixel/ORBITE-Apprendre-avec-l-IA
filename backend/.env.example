# ORBITE by Kweb — configuration d'environnement (backend)
# Copiez ce fichier en `.env` et remplissez les valeurs. Ne commit JAMAIS `.env`.

# --- Django ---
ORBITE_SECRET_KEY=change-me-in-production
ORBITE_DEBUG=1
ORBITE_ALLOWED_HOSTS=*

# --- Base de données ---
# postgres (défaut) ou sqlite pour le dev local / CI
ORBITE_DB=sqlite

# Valeurs utilisées si ORBITE_DB=postgres
ORBITE_DB_NAME=orbite
ORBITE_DB_USER=orbite
ORBITE_DB_PASSWORD=
ORBITE_DB_HOST=127.0.0.1
ORBITE_DB_PORT=5432

# --- JWT ---
ORBITE_JWT_ACCESS_MINUTES=60
ORBITE_JWT_REFRESH_DAYS=7

# --- CORS (frontend React) ---
ORBITE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- IA / LLM ---
# mock (dev, appel réseau aucun) | openai | anthropic
ORBITE_LLM_PROVIDER=mock
ORBITE_LLM_API_KEY=
ORBITE_LLM_MODEL=orbite-default
# URL de compatibilité OpenAI si nécessaire (optionnel)
# ORBITE_LLM_BASE_URL=https://api.openai.com/v1

# --- Paiements ---
# manual (dev) | orange_money (phase ultérieure, une fois validé)
ORBITE_PAYMENT_PROVIDER=manual

# --- Certificats ---
ORBITE_CERT_PREFIX=ORB
ORBITE_CERT_ISSUER=ORBITE by Kweb

# --- Site ---
ORBITE_SITE_URL=http://localhost:5173

# --- Email ---
ORBITE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ORBITE_FROM_EMAIL=orbite@orbite.example

# --- Redis / Celery ---
ORBITE_CELERY_BROKER=redis://localhost:6379/0
ORBITE_CELERY_EAGER=1
ORBITE_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache